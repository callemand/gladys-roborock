# Copy to docker/.env and fill in after installing the integration in the test
# Gladys. These are ONLY for the isolated dev environment (docker-compose.dev.yml).

# Timezone of the test Gladys container.
TZ=Europe/Paris

# --- Only needed to run the LOCAL integration build (profile "integration") ---
# The integration token the TEST Gladys issues for the Roborock integration.
# Never commit a real token.
GLADYS_INTEGRATION_TOKEN=
# Must match the selector of the integration as installed in the test Gladys.
GLADYS_INTEGRATION_SELECTOR=roborock
# Point at the test Gladys. Use the compose service name on a bridge network, or
# the NAS host address when the integration runs with network_mode: host.
GLADYS_HOST_API_URL=http://gladys-test:80
LOG_LEVEL=debug
